<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zd5_2_ShengalsRoman.MainPage"
             Title="Welcome"
             BackgroundColor="#1E1E1E">


    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="entryStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="Margin" Value="20,10" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>
            <Style x:Key="buttonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#F44336" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="45" />
                <Setter Property="Margin" Value="20,10" />
            </Style>
            <Style x:Key="labelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout VerticalOptions="CenterAndExpand" Spacing="15">
        <Label Text="Welcome" Style="{StaticResource labelStyle}" />

        <Entry x:Name="usernameEntry" Placeholder="Username" Style="{StaticResource entryStyle}" />

        <Button Text="Sign in"
                Style="{StaticResource buttonStyle}"
                Clicked="OnSignInClicked" />

        <Label x:Name="errorLabel" TextColor="Red" IsVisible="False" FontSize="14" HorizontalOptions="Center"/>
    </StackLayout>
</ContentPage>
